# ===============================
# Sistema de Cadastro de Alunos
# ===============================

# Vetor (lista) para armazenar os alunos
alunos = []

# Matriz (lista de listas) para armazenar apenas as notas
notas_matriz = []


# -------------------------------
# Função para cadastrar um aluno
# -------------------------------
def cadastrar_aluno():
    print("\n--- Cadastro de Aluno ---")
    nome = input("Digite o nome do aluno: ")
    idade = int(input("Digite a idade do aluno: "))
    serie = input("Digite a série do aluno: ")

    # Validação da nota
    while True:
        nota = float(input("Digite a nota do aluno (0 a 10): "))
        if 0 <= nota <= 10:
            break
        else:
            print("Nota inválida! Digite novamente (entre 0 e 10).")

    # Armazenando dados em dicionário (vetor de registros)
    aluno = {
        "nome": nome,
        "idade": idade,
        "serie": serie,
        "nota": nota
    }
    alunos.append(aluno)

    # Guardando nota em forma de vetor dentro da matriz
    notas_matriz.append([nota])


# ----------------------------------------
# Função para calcular a média da turma
# ----------------------------------------
def calcular_media():
    if len(alunos) == 0:
        return 0
    soma_notas = sum(aluno["nota"] for aluno in alunos)
    return soma_notas / len(alunos)

    
# ----------------------------------------
# Função para exibir resultados
# ----------------------------------------
def exibir_resultados():
    print("\n--- Resultados ---")
    print(f"Quantidade de alunos cadastrados: {len(alunos)}")
    print(f"Média da turma: {calcular_media():.2f}")

    print("\nLista de alunos cadastrados:")
    for aluno in alunos:
        print(f"{aluno['nome']} - Série: {aluno['serie']} - Nota: {aluno['nota']}")

    print("\nMatriz de notas (cada linha = um aluno):")
    for linha in notas_matriz:
        print(linha)


# ===============================
# Programa principal
# ===============================
def main():
    while True:
        cadastrar_aluno()
        continuar = input("Deseja cadastrar outro aluno? (s/n): ").lower()
        if continuar != "s":
            break

    exibir_resultados()


# Executa o programa
main()